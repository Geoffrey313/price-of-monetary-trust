# --- Credentials and environment ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
.venv/
venv/

# --- This repository publishes ONLY the code that reproduces the results. ---
# --- The manuscripts, the generated results, and licensed/raw input data stay out. ---
# Canonical manuscript tree (manuscript/<lang>/ssrn/…) and the legacy paper/ build
# inputs it reads (generated _gen fragments, meta) are workspace-only, never published.
/manuscript/
/paper/
/results/
/data/*
!/data/README.md
# The transformed inputs the offline run needs ARE shipped so `reproduce.py
# --from-derived` runs from a clean clone: the WRDS-free derived layer (small
# aggregated series, see data/derived/README.md) and the public vendored macro
# inputs (Kilian oil VAR, Fama-French 12-industry, FRED industrial production).
!/data/derived/
!/data/vendor/
!/data/macro_controls/
!/data/fred/

# --- Raw-data acquisition scripts: not part of the published reproduction. ---
# --- The offline path reads the shipped derived layer; these fetch licensed/  ---
# --- public raw inputs and are kept locally only (author-side regeneration).  ---
/src/data/fetch_fred.py
/src/data/fetch_inputs.py
/src/data/fred_snapshot.py
/src/data/wrds.py

# --- Pre-publication exploratory workspace (canonical code is under src/) ---
/tooling/

# --- Frozen pre-registration records (gate/freeze framing; superseded by the
#     full-sample methodology of the paper — kept locally, not published) ---
/protocol/*
# ...except the minimal conformance marker the published engine guard reads.
!/protocol/conformance-marker.md

# --- Internal working notes: audit reports, session logs (kept locally, not published) ---
/docs/

# --- LaTeX build artifacts (the .tex and .pdf are kept) ---
paper/*.aux
paper/*.log
paper/*.fls
paper/*.fdb_latexmk
paper/*.out
paper/*.toc
paper/*.synctex.gz

# stray LaTeX artifacts anywhere (root-level leaks)
*.fdb_latexmk
*.fls
*.synctex.gz
texput.*
*.aux
*.out
/*.log
paper/*.bbl
paper/*.blg

