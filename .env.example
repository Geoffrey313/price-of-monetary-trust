# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored and must never be committed.

# WRDS: equity and fundamentals reconstruction (headless password auth, no Duo prompt).
WRDS_USERNAME=
WRDS_PASSWORD=

# FRED: OECD Main Economic Indicators (short rates, exchange rates, prices).
FRED_API_KEY=

# Financial Modeling Prep: local-currency gold reference checks.
FMP_API_KEY=

# EODHD: Hang Seng total-return series (only needed for the extended market probes).
EODHD_API_KEY=
